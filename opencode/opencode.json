            }
          }
        }
      }
    },
    "openrouter": {
      "options": {
        "websearch_cited": {
          "model": "deepseek/deepseek-v4-flash-latest"
        }
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  }
}
